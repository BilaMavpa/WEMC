<Window x:Class="WEMC.ConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WEMC"
        mc:Ignorable="d"
        Title="Progress" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Height="175" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*"></RowDefinition>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition Height="0.05*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".2*"></ColumnDefinition>
                <ColumnDefinition Width=".6*"></ColumnDefinition>
                <ColumnDefinition Width=".2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Name="ElapsedTimeText" Grid.Column="0" Text="00:00:00" TextAlignment="Right" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0"></TextBlock>
            <ProgressBar Grid.Column="1" Name="ProgressBar" ></ProgressBar>
            <TextBlock Name="EtaTimeText" Grid.Column="2" Text="ETA: 00:00:00" TextAlignment="Left" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"></TextBlock>
        </Grid>
        <TextBlock  Grid.Row="2" Name="ProgressText" VerticalAlignment="Center" FontSize="15" TextWrapping="Wrap"
                   Text="frame=    0 fps=0.0 q=-0.0 size=       0KiB time=00:00:00.00 bitrate=  00.0kbits/s speed=0.000x elapsed=0:00:00.00">
            
        </TextBlock>
        <Button Grid.Row="3" Width="125" Content="Cancel" FontSize="25" Click="StopRender"></Button>
    </Grid>
</Window>
