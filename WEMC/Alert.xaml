<Window x:Class="WEMC.Alert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WEMC"
        mc:Ignorable="d"
        Title="Alert" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Height="175" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.05*"></RowDefinition>
            <RowDefinition Height="0.4*"></RowDefinition>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition Height="0.05*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Name="TextBlock" Text="Alert text" TextAlignment="Center" VerticalAlignment="Top" FontSize="20" TextWrapping="Wrap"></TextBlock>
        <Button Grid.Row="2" Width="125" Content="Close" FontSize="25" Click="CloseWindow"></Button>
    </Grid>
</Window>
    