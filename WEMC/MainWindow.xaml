<Window x:Class="WEMC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WEMC"
        mc:Ignorable="d"
        Title="Convert File" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="95"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Name="FilePath"  Text="Path: " HorizontalAlignment="Center" VerticalAlignment="top" FontSize="20" TextWrapping="Wrap"></TextBlock>
            <TextBlock Name="FileName" Grid.Column="1"  Text="Name:" HorizontalAlignment="Center" VerticalAlignment="top" FontSize="20" TextWrapping="Wrap"></TextBlock>
        </Grid>
        
        <Grid Grid.Row="1" Grid.Column="0" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".625*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock  Text="Video format:" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="24"></TextBlock>
            <TextBox Name="FormatInput" Grid.Column="1" FontSize="25" TextAlignment="Left" Text=".webm"></TextBox>
        </Grid>
        
        <Grid Grid.Row="2" Grid.Column="0" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".625*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock  Text="Video FPS:" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="25"></TextBlock>
            <TextBox Name="FpsInput" Grid.Column="1" FontSize="25" TextAlignment="Left" Text="60" PreviewTextInput="PreviewNumberInput"></TextBox>
        </Grid>
        
        <Grid Grid.Row="3" Grid.Column="0" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".625*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <CheckBox VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Right" Checked="StartTimeToggle" Unchecked="StartTimeToggle">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                </CheckBox.LayoutTransform>
                <TextBlock Text="Start time:" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20"></TextBlock>
            </CheckBox>
            <TextBox Name="StartInput" Grid.Column="1" MaxLength="8" FontSize="25" TextAlignment="Left" Text="00:00:00" IsReadOnly="True" Background="LightGray" PreviewTextInput="PreviewTimeInput"></TextBox>
        </Grid>
        
        <Grid Grid.Row="4" Grid.Column="0" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".625*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <CheckBox Name="DurationCheckBox" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Right" Checked="DurationToggle" Unchecked="DurationToggle">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                </CheckBox.LayoutTransform>
                <TextBlock Text="Duration:" Margin="8,0,3,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"></TextBlock>
            </CheckBox>
            <TextBox Name="DurationInput" Grid.Column="1" MaxLength="8" FontSize="25" TextAlignment="Left" Text="00:00:00" IsReadOnly="True" Background="LightGray" PreviewTextInput="PreviewTimeInput"></TextBox>
        </Grid>
        
        <Grid Grid.Row="5" Grid.Column="0" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".625*"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <CheckBox VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Right" Checked="SizeToggle" Unchecked="SizeToggle">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                </CheckBox.LayoutTransform>
                <TextBlock Text="Target size(Mb):" Margin="8,0,1,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"></TextBlock>
            </CheckBox>
            <TextBox Name="SizeInput" Grid.Column="1" MaxLength="8" FontSize="25" TextAlignment="Left" Text="10" IsReadOnly="True" Background="LightGray" PreviewTextInput="PreviewNumberInput"></TextBox>
        </Grid>
        
        <Grid Grid.Row="2" Grid.Column="1" Margin="50,5,50,0">
            <Grid.Resources>
                <local:HwaccelOptions x:Key="Options"/>
            </Grid.Resources>
            <TextBlock  Text="hwaccel:" Margin="0,0,3,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="25"></TextBlock>
            <ComboBox Name="HwaccelComboBox" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                       SelectedIndex="0" FontSize="17" VerticalContentAlignment="Center" ItemsSource="{StaticResource Options}"></ComboBox>
        </Grid>
        
        <Grid Grid.Row="1" Grid.Column="1" Margin="50,5,50,0">
            <Grid.Resources>
                <local:AudioTracksOptions x:Key="Options"/>
            </Grid.Resources>
            <TextBlock  Text="Audio tracks:" Margin="0,0,3,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="25"></TextBlock>
            <ComboBox Name="AudioComboBox" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"
                       SelectedIndex="0" FontSize="17" VerticalContentAlignment="Center" ItemsSource="{StaticResource Options}"></ComboBox>
        </Grid>
        
        <Grid Grid.Row="3" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Video codec: " FontSize="25" TextAlignment="Center"></TextBlock>
            <TextBox Name="CodecInput" Grid.Row="1" Margin="50,0" FontSize="25" TextAlignment="Center" Text="vp9_qsv"></TextBox>
        </Grid>
        
        <Grid Grid.Row="6" Grid.ColumnSpan="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="Output name" TextAlignment="Center" FontSize="25" VerticalAlignment="Center"></TextBlock>
            <TextBox Name="NameInput" Margin="125,0" Grid.Row="1" FontSize="25" TextAlignment="Center"></TextBox>
        </Grid>
        
        <Button Grid.Row="8" Grid.ColumnSpan="2" Grid.Column="0" Width="200" FontSize="40" Content="Convert" Click="ConvertEvent"></Button>
    </Grid>
</Window>
